<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduStoryInteractionMapper">
    
    <resultMap type="com.edudu.edu.domain.EduStoryInteraction" id="EduStoryInteractionResult">
        <result property="id"    column="id"    />
        <result property="storyId"    column="story_id"    />
        <result property="question"    column="question"    />
        <result property="sort"    column="sort"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectEduStoryInteractionVo">
        select id, story_id, question, sort, create_time from edu_story_interaction
    </sql>

    <select id="selectEduStoryInteractionList" parameterType="EduStoryInteraction" resultMap="EduStoryInteractionResult">
        <include refid="selectEduStoryInteractionVo"/>
        <where>  
            <if test="storyId != null "> and story_id = #{storyId}</if>
            <if test="question != null  and question != ''"> and question = #{question}</if>
            <if test="sort != null "> and sort = #{sort}</if>
        </where>
    </select>
    
    <select id="selectEduStoryInteractionById" parameterType="Long" resultMap="EduStoryInteractionResult">
        <include refid="selectEduStoryInteractionVo"/>
        where id = #{id}
    </select>

    <insert id="insertEduStoryInteraction" parameterType="EduStoryInteraction" useGeneratedKeys="true" keyProperty="id">
        insert into edu_story_interaction
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storyId != null">story_id,</if>
            <if test="question != null and question != ''">question,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="storyId != null">#{storyId},</if>
            <if test="question != null and question != ''">#{question},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateEduStoryInteraction" parameterType="EduStoryInteraction">
        update edu_story_interaction
        <trim prefix="SET" suffixOverrides=",">
            <if test="storyId != null">story_id = #{storyId},</if>
            <if test="question != null and question != ''">question = #{question},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEduStoryInteractionById" parameterType="Long">
        delete from edu_story_interaction where id = #{id}
    </delete>

    <delete id="deleteEduStoryInteractionByIds" parameterType="String">
        delete from edu_story_interaction where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>