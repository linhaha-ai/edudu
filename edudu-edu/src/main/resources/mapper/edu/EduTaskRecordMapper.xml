<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduTaskRecordMapper">
    
    <resultMap type="com.edudu.edu.domain.EduTaskRecord" id="EduTaskRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="childId"    column="child_id"    />
        <result property="taskId"    column="task_id"    />
        <result property="taskTitle"    column="task_title"    />
        <result property="status"    column="status"    />
        <result property="feedback"    column="feedback"    />
        <result property="completedAt"    column="completed_at"    />
        <result property="recordDate"    column="record_date"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectEduTaskRecordVo">
        select id, user_id, child_id, task_id, task_title, status, feedback, completed_at, record_date, create_by, create_time, update_by, update_time from edu_task_record
    </sql>

    <select id="selectEduTaskRecordList" parameterType="EduTaskRecord" resultMap="EduTaskRecordResult">
        <include refid="selectEduTaskRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="childId != null "> and child_id = #{childId}</if>
            <if test="taskId != null "> and task_id = #{taskId}</if>
            <if test="taskTitle != null  and taskTitle != ''"> and task_title = #{taskTitle}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="feedback != null  and feedback != ''"> and feedback = #{feedback}</if>
            <if test="completedAt != null "> and completed_at = #{completedAt}</if>
            <if test="recordDate != null "> and record_date = #{recordDate}</if>
        </where>
    </select>
    
    <select id="selectEduTaskRecordById" parameterType="Long" resultMap="EduTaskRecordResult">
        <include refid="selectEduTaskRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertEduTaskRecord" parameterType="EduTaskRecord" useGeneratedKeys="true" keyProperty="id">
        insert into edu_task_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="childId != null">child_id,</if>
            <if test="taskId != null">task_id,</if>
            <if test="taskTitle != null">task_title,</if>
            <if test="status != null">status,</if>
            <if test="feedback != null">feedback,</if>
            <if test="completedAt != null">completed_at,</if>
            <if test="recordDate != null">record_date,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="childId != null">#{childId},</if>
            <if test="taskId != null">#{taskId},</if>
            <if test="taskTitle != null">#{taskTitle},</if>
            <if test="status != null">#{status},</if>
            <if test="feedback != null">#{feedback},</if>
            <if test="completedAt != null">#{completedAt},</if>
            <if test="recordDate != null">#{recordDate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEduTaskRecord" parameterType="EduTaskRecord">
        update edu_task_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="childId != null">child_id = #{childId},</if>
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="taskTitle != null">task_title = #{taskTitle},</if>
            <if test="status != null">status = #{status},</if>
            <if test="feedback != null">feedback = #{feedback},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            <if test="recordDate != null">record_date = #{recordDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEduTaskRecordById" parameterType="Long">
        delete from edu_task_record where id = #{id}
    </delete>

    <delete id="deleteEduTaskRecordByIds" parameterType="String">
        delete from edu_task_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>