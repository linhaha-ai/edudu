<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduGrowthRecordMapper">
    
    <resultMap type="com.edudu.edu.domain.EduGrowthRecord" id="EduGrowthRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="childId"    column="child_id"    />
        <result property="type"    column="type"    />
        <result property="value"    column="value"    />
        <result property="unit"    column="unit"    />
        <result property="note"    column="note"    />
        <result property="recordDate"    column="record_date"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectEduGrowthRecordVo">
        select id, user_id, child_id, type, value, unit, note, record_date, create_by, create_time, update_by, update_time from edu_growth_record
    </sql>

    <select id="selectEduGrowthRecordList" parameterType="EduGrowthRecord" resultMap="EduGrowthRecordResult">
        <include refid="selectEduGrowthRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="childId != null "> and child_id = #{childId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="value != null  and value != ''"> and value = #{value}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="note != null  and note != ''"> and note = #{note}</if>
            <if test="recordDate != null "> and record_date = #{recordDate}</if>
        </where>
    </select>
    
    <select id="selectEduGrowthRecordById" parameterType="Long" resultMap="EduGrowthRecordResult">
        <include refid="selectEduGrowthRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertEduGrowthRecord" parameterType="EduGrowthRecord" useGeneratedKeys="true" keyProperty="id">
        insert into edu_growth_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="childId != null">child_id,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="value != null">value,</if>
            <if test="unit != null">unit,</if>
            <if test="note != null">note,</if>
            <if test="recordDate != null">record_date,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="childId != null">#{childId},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="value != null">#{value},</if>
            <if test="unit != null">#{unit},</if>
            <if test="note != null">#{note},</if>
            <if test="recordDate != null">#{recordDate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEduGrowthRecord" parameterType="EduGrowthRecord">
        update edu_growth_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="childId != null">child_id = #{childId},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="value != null">value = #{value},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="note != null">note = #{note},</if>
            <if test="recordDate != null">record_date = #{recordDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEduGrowthRecordById" parameterType="Long">
        delete from edu_growth_record where id = #{id}
    </delete>

    <delete id="deleteEduGrowthRecordByIds" parameterType="String">
        delete from edu_growth_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>