<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduParentAnswerMapper">
    
    <resultMap type="com.edudu.edu.domain.EduParentAnswer" id="EduParentAnswerResult">
        <result property="id"    column="id"    />
        <result property="questionId"    column="question_id"    />
        <result property="analysis"    column="analysis"    />
        <result property="solutions"    column="solutions"    />
        <result property="example"    column="example"    />
        <result property="modelType"    column="model_type"    />
        <result property="tokensUsed"    column="tokens_used"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectEduParentAnswerVo">
        select id, question_id, analysis, solutions, example, model_type, tokens_used, create_by, create_time from edu_parent_answer
    </sql>

    <select id="selectEduParentAnswerList" parameterType="EduParentAnswer" resultMap="EduParentAnswerResult">
        <include refid="selectEduParentAnswerVo"/>
        <where>  
            <if test="questionId != null "> and question_id = #{questionId}</if>
            <if test="analysis != null  and analysis != ''"> and analysis = #{analysis}</if>
            <if test="solutions != null  and solutions != ''"> and solutions = #{solutions}</if>
            <if test="example != null  and example != ''"> and example = #{example}</if>
            <if test="modelType != null  and modelType != ''"> and model_type = #{modelType}</if>
            <if test="tokensUsed != null "> and tokens_used = #{tokensUsed}</if>
        </where>
    </select>
    
    <select id="selectEduParentAnswerById" parameterType="Long" resultMap="EduParentAnswerResult">
        <include refid="selectEduParentAnswerVo"/>
        where id = #{id}
    </select>

    <insert id="insertEduParentAnswer" parameterType="EduParentAnswer" useGeneratedKeys="true" keyProperty="id">
        insert into edu_parent_answer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="questionId != null">question_id,</if>
            <if test="analysis != null">analysis,</if>
            <if test="solutions != null">solutions,</if>
            <if test="example != null">example,</if>
            <if test="modelType != null">model_type,</if>
            <if test="tokensUsed != null">tokens_used,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="questionId != null">#{questionId},</if>
            <if test="analysis != null">#{analysis},</if>
            <if test="solutions != null">#{solutions},</if>
            <if test="example != null">#{example},</if>
            <if test="modelType != null">#{modelType},</if>
            <if test="tokensUsed != null">#{tokensUsed},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateEduParentAnswer" parameterType="EduParentAnswer">
        update edu_parent_answer
        <trim prefix="SET" suffixOverrides=",">
            <if test="questionId != null">question_id = #{questionId},</if>
            <if test="analysis != null">analysis = #{analysis},</if>
            <if test="solutions != null">solutions = #{solutions},</if>
            <if test="example != null">example = #{example},</if>
            <if test="modelType != null">model_type = #{modelType},</if>
            <if test="tokensUsed != null">tokens_used = #{tokensUsed},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEduParentAnswerById" parameterType="Long">
        delete from edu_parent_answer where id = #{id}
    </delete>

    <delete id="deleteEduParentAnswerByIds" parameterType="String">
        delete from edu_parent_answer where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectEduParentAnswerByQuestionId" parameterType="Long" resultMap="EduParentAnswerResult">
        <include refid="selectEduParentAnswerVo"/>
        where question_id = #{questionId} limit 1
    </select>
</mapper>