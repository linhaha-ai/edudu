<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduChildMapper">
    
    <resultMap type="com.edudu.edu.domain.EduChild" id="EduChildResult">
        <result property="childId"    column="child_id"    />
        <result property="userId"    column="user_id"    />
        <result property="name"    column="name"    />
        <result property="gender"    column="gender"    />
        <result property="birthDate"    column="birth_date"    />
        <result property="avatar"    column="avatar"    />
        <result property="personality"    column="personality"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEduChildVo">
        select child_id, user_id, name, gender, birth_date, avatar, personality, del_flag, create_by, create_time, update_by, update_time, remark from edu_child
    </sql>

    <select id="selectEduChildList" parameterType="EduChild" resultMap="EduChildResult">
        <include refid="selectEduChildVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="gender != null  and gender != ''"> and gender = #{gender}</if>
            <if test="birthDate != null "> and birth_date = #{birthDate}</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="personality != null  and personality != ''"> and personality = #{personality}</if>
        </where>
    </select>
    
    <select id="selectEduChildByChildId" parameterType="Long" resultMap="EduChildResult">
        <include refid="selectEduChildVo"/>
        where child_id = #{childId}
    </select>

    <insert id="insertEduChild" parameterType="EduChild" useGeneratedKeys="true" keyProperty="childId">
        insert into edu_child
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="gender != null">gender,</if>
            <if test="birthDate != null">birth_date,</if>
            <if test="avatar != null">avatar,</if>
            <if test="personality != null">personality,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="gender != null">#{gender},</if>
            <if test="birthDate != null">#{birthDate},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="personality != null">#{personality},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateEduChild" parameterType="EduChild">
        update edu_child
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthDate != null">birth_date = #{birthDate},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="personality != null">personality = #{personality},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where child_id = #{childId}
    </update>

    <delete id="deleteEduChildByChildId" parameterType="Long">
        delete from edu_child where child_id = #{childId}
    </delete>

    <delete id="deleteEduChildByChildIds" parameterType="String">
        delete from edu_child where child_id in 
        <foreach item="childId" collection="array" open="(" separator="," close=")">
            #{childId}
        </foreach>
    </delete>
</mapper>