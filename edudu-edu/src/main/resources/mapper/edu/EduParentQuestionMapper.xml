<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduParentQuestionMapper">
    
    <resultMap type="com.edudu.edu.domain.EduParentQuestion" id="EduParentQuestionResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="childId"    column="child_id"    />
        <result property="question"    column="question"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectEduParentQuestionVo">
        select id, user_id, child_id, question, status, create_by, create_time, update_by, update_time from edu_parent_question
    </sql>

    <select id="selectEduParentQuestionList" parameterType="EduParentQuestion" resultMap="EduParentQuestionResult">
        <include refid="selectEduParentQuestionVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="childId != null "> and child_id = #{childId}</if>
            <if test="question != null  and question != ''"> and question = #{question}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectEduParentQuestionById" parameterType="Long" resultMap="EduParentQuestionResult">
        <include refid="selectEduParentQuestionVo"/>
        where id = #{id}
    </select>

    <insert id="insertEduParentQuestion" parameterType="EduParentQuestion" useGeneratedKeys="true" keyProperty="id">
        insert into edu_parent_question
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="childId != null">child_id,</if>
            <if test="question != null and question != ''">question,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="childId != null">#{childId},</if>
            <if test="question != null and question != ''">#{question},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEduParentQuestion" parameterType="EduParentQuestion">
        update edu_parent_question
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="childId != null">child_id = #{childId},</if>
            <if test="question != null and question != ''">question = #{question},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEduParentQuestionById" parameterType="Long">
        delete from edu_parent_question where id = #{id}
    </delete>

    <delete id="deleteEduParentQuestionByIds" parameterType="String">
        delete from edu_parent_question where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>