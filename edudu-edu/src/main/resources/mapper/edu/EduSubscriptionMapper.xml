<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edudu.edu.mapper.EduSubscriptionMapper">
    
    <resultMap type="com.edudu.edu.domain.EduSubscription" id="EduSubscriptionResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="plan"    column="plan"    />
        <result property="status"    column="status"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEduSubscriptionVo">
        select id, user_id, plan, status, start_time, end_time, create_by, create_time, update_by, update_time, remark from edu_subscription
    </sql>

    <select id="selectEduSubscriptionList" parameterType="EduSubscription" resultMap="EduSubscriptionResult">
        <include refid="selectEduSubscriptionVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="plan != null  and plan != ''"> and plan = #{plan}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
        </where>
    </select>
    
    <select id="selectEduSubscriptionById" parameterType="Long" resultMap="EduSubscriptionResult">
        <include refid="selectEduSubscriptionVo"/>
        where id = #{id}
    </select>

    <insert id="insertEduSubscription" parameterType="EduSubscription" useGeneratedKeys="true" keyProperty="id">
        insert into edu_subscription
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="plan != null and plan != ''">plan,</if>
            <if test="status != null">status,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="plan != null and plan != ''">#{plan},</if>
            <if test="status != null">#{status},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateEduSubscription" parameterType="EduSubscription">
        update edu_subscription
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="plan != null and plan != ''">plan = #{plan},</if>
            <if test="status != null">status = #{status},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteEduSubscriptionById" parameterType="Long">
        delete from edu_subscription where id = #{id}
    </delete>

    <delete id="deleteEduSubscriptionByIds" parameterType="String">
        delete from edu_subscription where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>